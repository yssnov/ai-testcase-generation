# Copy to .env and fill in real values locally. Never commit .env.

# Database
DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5432/testgen

# Local LLM server (Ollama in development, vLLM in production; both expose an OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=local-placeholder

# Embeddings
EMBEDDING_MODEL=bge-m3

# Application
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=10
